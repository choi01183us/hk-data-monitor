  "anchors": [
    {
      "id": "sum",
      "text_zh": "四大行業加埋佔 58.2% —— 即係每 100 蚊經濟產值,有 41.8 蚊嚟自其他行業",
      "basis_zh": "10.3 + 2.8 + 18.9 + 26.2 = 58.2"
    },
    {
      "id": "top",
      "text_zh": "最大嗰個係金融服務,佔 26.2%",
      "basis_zh": "2024 年四個數入面最大"
